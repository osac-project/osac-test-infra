#!/usr/bin/env python3
"""Collect selected compact-clone host diagnostics before teardown."""
from __future__ import annotations

import hashlib
import os
import pathlib
import pwd
import re
import stat
import subprocess
import sys

_CLONE_ID = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,29}[a-z0-9])?$")
_RUNNER_TEMP = re.compile(r"^runner-[1-9][0-9]*/_work/_temp$")
_COMPACT_DOMAIN_ROLES = ("master-0-0", "master-0-1", "master-0-2")
_DOMAIN_STATES = {"nostate", "running", "blocked", "paused", "shutdown", "shut off", "crashed", "pmsuspended"}
_NETWORK_STATE_FIELDS = ("active", "persistent", "autostart")
_MAX_COMMAND_BYTES = 256 * 1024
_DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW


def fail(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def open_directory(path: pathlib.PurePosixPath) -> int:
    """Open every path component without following symlinks."""
    if not path.is_absolute() or ".." in path.parts:
        fail(f"Invalid directory path: {path}")
    fd = os.open("/", _DIRECTORY_FLAGS)
    try:
        for component in path.parts[1:]:
            next_fd = os.open(component, _DIRECTORY_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        return fd
    except Exception:
        os.close(fd)
        raise


def ensure_output_directory(parent_fd: int, name: str, uid: int, gid: int) -> int:
    created = False
    try:
        os.mkdir(name, mode=0o750, dir_fd=parent_fd)
        created = True
    except FileExistsError:
        pass
    fd = os.open(name, _DIRECTORY_FLAGS, dir_fd=parent_fd)
    info = os.fstat(fd)
    if not stat.S_ISDIR(info.st_mode) or (info.st_uid != uid and not created):
        os.close(fd)
        fail(f"Output directory {name!r} must be owned by github-runner")
    os.fchown(fd, uid, gid)
    os.fchmod(fd, 0o750)
    return fd


def write_output(directory_fd: int, name: str, content: bytes, uid: int, gid: int) -> None:
    """Replace a single output file without following a runner-owned symlink."""
    try:
        os.unlink(name, dir_fd=directory_fd)
    except FileNotFoundError:
        pass
    fd = os.open(
        name,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        0o640,
        dir_fd=directory_fd,
    )
    try:
        os.fchown(fd, uid, gid)
        os.fchmod(fd, 0o640)
        with os.fdopen(fd, "wb", closefd=False) as output:
            output.write(content)
    finally:
        os.close(fd)


def cluster_tool_log_notice() -> bytes:
    """Keep a useful artifact entry without publishing the raw clone log."""
    return b"Raw cluster-tool log omitted because it may contain sensitive data.\n"


def run_command(args: list[str]) -> tuple[bytes, bool]:
    try:
        result = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False, timeout=15)
        return result.stdout[-_MAX_COMMAND_BYTES :], result.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return b"", False


def collect_libvirt(clone_id: str, kind: str) -> bytes:
    if kind == "list":
        output = ["Compact clone domain states:"]
        for role in _COMPACT_DOMAIN_ROLES:
            name = f"test-infra-cluster-{clone_id}-{role}"
            state_output, succeeded = run_command(["virsh", "-c", "qemu:///system", "domstate", name])
            state = state_output.decode(errors="replace").strip().lower()
            if not succeeded or state not in _DOMAIN_STATES:
                state = "unavailable"
            output.append(f"{role}: {state}")
        return "\n".join(output).encode()

    name = f"test-infra-net-{clone_id}"
    network_output, succeeded = run_command(["virsh", "-c", "qemu:///system", "net-info", name])
    states = dict.fromkeys(_NETWORK_STATE_FIELDS, "unavailable")
    if succeeded:
        for line in network_output.decode(errors="replace").splitlines():
            key, separator, value = line.partition(":")
            field = key.strip().lower() if separator else None
            normalized_value = value.strip().lower()
            if field in _NETWORK_STATE_FIELDS and normalized_value in {"yes", "no"}:
                states[field] = normalized_value
    output = ["Compact clone network state:"]
    output.extend(f"{field}: {states[field]}" for field in _NETWORK_STATE_FIELDS)
    return "\n".join(output).encode()


def collect_bridges(clone_id: str) -> bytes:
    prefix = f"br-{hashlib.sha256(clone_id.encode()).hexdigest()[:8]}"
    link_output, succeeded = run_command(["ip", "-o", "link", "show", "type", "bridge"])
    if not succeeded:
        return b"Compact clone bridge status: unavailable\n"
    lines = link_output.decode(errors="replace").splitlines()
    present = any(len(line.split()) > 1 and line.split()[1].rstrip(":").startswith(prefix) for line in lines)
    state = "present" if present else "absent"
    return f"Compact clone bridge status: {state}\n".encode()


def main() -> None:
    if len(sys.argv) != 3:
        fail("Usage: osac-compact-boot-diagnostics CLONE_ID RUNNER_TEMP", 2)
    clone_id, runner_temp_arg = sys.argv[1:]
    if not _CLONE_ID.fullmatch(clone_id):
        fail(f"Invalid compact clone ID: {clone_id}", 2)

    runner = pwd.getpwnam("github-runner")
    if os.environ.get("SUDO_USER") != runner.pw_name:
        fail("This command must be run through sudo by github-runner")
    try:
        uid = int(os.environ["SUDO_UID"])
        gid = int(os.environ["SUDO_GID"])
    except (KeyError, ValueError):
        fail("Could not determine the invoking runner's UID and GID")
    if uid != runner.pw_uid:
        fail("This command must be run through sudo by github-runner")

    runner_temp = pathlib.PurePosixPath(runner_temp_arg)
    runner_root = pathlib.PurePosixPath(runner.pw_dir) / "action-runners"
    try:
        relative = runner_temp.relative_to(runner_root)
    except ValueError:
        fail("RUNNER_TEMP must be a registered github-runner temp directory", 2)
    if not _RUNNER_TEMP.fullmatch(str(relative)):
        fail("RUNNER_TEMP must be a registered github-runner temp directory", 2)

    runner_temp_fd = open_directory(runner_temp)
    try:
        if os.fstat(runner_temp_fd).st_uid != uid:
            fail("RUNNER_TEMP must be owned by the invoking runner user")
        artifact_fd = ensure_output_directory(runner_temp_fd, "osac-artifacts", uid, gid)
        try:
            diagnostics_fd = ensure_output_directory(artifact_fd, "compact-boot", uid, gid)
            try:
                write_output(diagnostics_fd, "cluster-tool.log", cluster_tool_log_notice(), uid, gid)
                write_output(diagnostics_fd, "libvirt-domains.txt", collect_libvirt(clone_id, "list"), uid, gid)
                write_output(diagnostics_fd, "libvirt-networks.txt", collect_libvirt(clone_id, "net-list"), uid, gid)
                write_output(diagnostics_fd, "bridges.txt", collect_bridges(clone_id), uid, gid)
                write_output(diagnostics_fd, ".collection-complete", b"complete\n", uid, gid)
            finally:
                os.close(diagnostics_fd)
        finally:
            os.close(artifact_fd)
    finally:
        os.close(runner_temp_fd)


if __name__ == "__main__":
    main()
