#!/usr/bin/env python3
"""Safely stage a compact clone's kubeconfig in a runner temp directory."""
from __future__ import annotations

import os
import pathlib
import pwd
import re
import stat
import sys

_CLONE_ID = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,29}[a-z0-9])?$")
_RUNNER_TEMP = re.compile(r"^runner-[1-9][0-9]*/_work/_temp$")
_DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW


def fail(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def open_directory(path: pathlib.PurePosixPath) -> int:
    """Open every path component without following symlinks."""
    if not path.is_absolute() or ".." in path.parts:
        fail(f"Invalid directory path: {path}", 2)

    fd = os.open("/", _DIRECTORY_FLAGS)
    try:
        for component in path.parts[1:]:
            next_fd = os.open(component, _DIRECTORY_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        return fd
    except Exception:
        os.close(fd)
        raise


def write_kubeconfig(source_fd: int, directory_fd: int, uid: int, gid: int) -> None:
    """Write kubeconfig without following runner-controlled filesystem links."""
    try:
        os.unlink("kubeconfig", dir_fd=directory_fd)
    except FileNotFoundError:
        pass

    destination_fd = os.open(
        "kubeconfig",
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        0o600,
        dir_fd=directory_fd,
    )
    try:
        os.fchown(destination_fd, uid, gid)
        os.fchmod(destination_fd, 0o600)
        while chunk := os.read(source_fd, 1024 * 1024):
            view = memoryview(chunk)
            while view:
                view = view[os.write(destination_fd, view) :]
        os.fsync(destination_fd)
    except Exception:
        os.close(destination_fd)
        try:
            os.unlink("kubeconfig", dir_fd=directory_fd)
        except FileNotFoundError:
            pass
        raise
    else:
        os.close(destination_fd)


def stage_kubeconfig(clone_id: str, runner_temp_arg: str) -> None:
    runner = pwd.getpwnam("github-runner")
    if os.environ.get("SUDO_USER") != runner.pw_name:
        fail("This command must be run through sudo by github-runner")
    try:
        uid = int(os.environ["SUDO_UID"])
        gid = int(os.environ["SUDO_GID"])
    except (KeyError, ValueError):
        fail("Could not determine the invoking runner's UID and GID")
    if uid != runner.pw_uid or gid != runner.pw_gid:
        fail("This command must be run through sudo by github-runner")

    runner_temp = pathlib.PurePosixPath(runner_temp_arg)
    if runner_temp_arg != runner_temp.as_posix():
        fail("RUNNER_TEMP must be a canonical absolute path", 2)
    runner_root = pathlib.PurePosixPath(runner.pw_dir) / "action-runners"
    try:
        relative = runner_temp.relative_to(runner_root)
    except ValueError:
        fail("RUNNER_TEMP must be a registered github-runner temp directory", 2)
    if not _RUNNER_TEMP.fullmatch(str(relative)):
        fail("RUNNER_TEMP must be a registered github-runner temp directory", 2)

    runner_temp_fd = open_directory(runner_temp)
    try:
        temp_info = os.fstat(runner_temp_fd)
        if not stat.S_ISDIR(temp_info.st_mode) or temp_info.st_uid != uid:
            fail("RUNNER_TEMP must be a directory owned by github-runner")

        clone_dir = pathlib.PurePosixPath(f"/var/lib/libvirt/images/{clone_id}")
        clone_dir_fd = open_directory(clone_dir)
        try:
            clone_info = os.fstat(clone_dir_fd)
            if not stat.S_ISDIR(clone_info.st_mode) or clone_info.st_uid != 0:
                fail("Compact clone directory must be owned by root")

            source_fd = os.open(
                "clone.kubeconfig",
                os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                dir_fd=clone_dir_fd,
            )
            try:
                source_info = os.fstat(source_fd)
                if not stat.S_ISREG(source_info.st_mode) or source_info.st_uid != 0:
                    fail("Compact kubeconfig must be a regular file owned by root")
                write_kubeconfig(source_fd, runner_temp_fd, uid, gid)
            finally:
                os.close(source_fd)
        finally:
            os.close(clone_dir_fd)
    finally:
        os.close(runner_temp_fd)


def main() -> None:
    if len(sys.argv) != 3:
        fail("Usage: osac-compact-kubeconfig CLONE_ID RUNNER_TEMP", 2)
    clone_id, runner_temp = sys.argv[1:]
    if not _CLONE_ID.fullmatch(clone_id):
        fail(f"Invalid compact clone ID: {clone_id}", 2)

    try:
        stage_kubeconfig(clone_id, runner_temp)
    except OSError as exc:
        fail(f"Could not stage compact kubeconfig: {exc.strerror or exc}")

    print("Compact kubeconfig staged in RUNNER_TEMP.")


if __name__ == "__main__":
    main()
