#!/usr/bin/env python3
"""Safely stage a root-owned cluster kubeconfig in a runner temp directory."""
from __future__ import annotations

import os
import pathlib
import pwd
import re
import stat
import sys

_CLONE_ID = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,29}[a-z0-9])?$")
_RUNNER_TEMP = re.compile(r"^runner-[1-9][0-9]*/_work/_temp$")
_DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW


def fail(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def open_directory(path: pathlib.PurePosixPath) -> int:
    """Open each directory component without following symlinks."""
    if not path.is_absolute() or ".." in path.parts:
        fail(f"Invalid directory path: {path}", 2)

    fd = os.open("/", _DIRECTORY_FLAGS)
    try:
        for component in path.parts[1:]:
            next_fd = os.open(component, _DIRECTORY_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        return fd
    except Exception:
        os.close(fd)
        raise


def copy_kubeconfig(source_fd: int, destination_fd: int, uid: int, gid: int) -> None:
    try:
        os.unlink("kubeconfig", dir_fd=destination_fd)
    except FileNotFoundError:
        pass

    output_fd = os.open(
        "kubeconfig",
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        0o600,
        dir_fd=destination_fd,
    )
    try:
        os.fchown(output_fd, uid, gid)
        os.fchmod(output_fd, 0o600)
        while chunk := os.read(source_fd, 1024 * 1024):
            view = memoryview(chunk)
            while view:
                view = view[os.write(output_fd, view) :]
        os.fsync(output_fd)
    except Exception:
        os.close(output_fd)
        try:
            os.unlink("kubeconfig", dir_fd=destination_fd)
        except FileNotFoundError:
            pass
        raise
    else:
        os.close(output_fd)


def stage_kubeconfig(topology: str, clone_id: str, runner_temp_arg: str) -> None:
    try:
        uid = int(os.environ["OSAC_CALLER_UID"])
        pkexec_uid = int(os.environ["PKEXEC_UID"])
    except (KeyError, ValueError):
        fail("Could not determine the invoking user's UID")
    runner = pwd.getpwuid(uid)
    gid = runner.pw_gid
    if uid != pkexec_uid or os.environ.get("OSAC_CALLER_USER") != runner.pw_name:
        fail("This command must be invoked through osac-privileged")

    runner_temp = pathlib.PurePosixPath(runner_temp_arg)
    if runner_temp_arg != runner_temp.as_posix():
        fail("RUNNER_TEMP must be a canonical absolute path", 2)
    runner_root = pathlib.PurePosixPath(runner.pw_dir) / "action-runners"
    try:
        relative = runner_temp.relative_to(runner_root)
    except ValueError:
        fail("RUNNER_TEMP must be a registered caller temp directory", 2)
    if not _RUNNER_TEMP.fullmatch(str(relative)):
        fail("RUNNER_TEMP must be a registered caller temp directory", 2)

    if topology == "sno":
        source_dir = pathlib.PurePosixPath("/root/.kube")
        source_name = f"{clone_id}.kubeconfig"
    else:
        source_dir = pathlib.PurePosixPath("/var/lib/libvirt/images") / clone_id
        source_name = "clone.kubeconfig"

    runner_temp_fd = open_directory(runner_temp)
    try:
        temp_info = os.fstat(runner_temp_fd)
        if not stat.S_ISDIR(temp_info.st_mode) or temp_info.st_uid != uid:
            fail("RUNNER_TEMP must be a directory owned by the caller")

        source_dir_fd = open_directory(source_dir)
        try:
            directory_info = os.fstat(source_dir_fd)
            if not stat.S_ISDIR(directory_info.st_mode) or directory_info.st_uid != 0:
                fail("Cluster kubeconfig directory must be owned by root")
            source_fd = os.open(
                source_name,
                os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                dir_fd=source_dir_fd,
            )
            try:
                source_info = os.fstat(source_fd)
                if not stat.S_ISREG(source_info.st_mode) or source_info.st_uid != 0:
                    fail("Cluster kubeconfig must be a regular file owned by root")
                copy_kubeconfig(source_fd, runner_temp_fd, uid, gid)
            finally:
                os.close(source_fd)
        finally:
            os.close(source_dir_fd)
    finally:
        os.close(runner_temp_fd)


def main() -> None:
    if len(sys.argv) != 4:
        fail("Usage: osac-cluster-kubeconfig sno|mno CLONE_ID RUNNER_TEMP", 2)
    topology, clone_id, runner_temp = sys.argv[1:]
    if topology not in {"sno", "mno"}:
        fail(f"Invalid topology: {topology}", 2)
    if not _CLONE_ID.fullmatch(clone_id):
        fail(f"Invalid cluster clone ID: {clone_id}", 2)

    try:
        stage_kubeconfig(topology, clone_id, runner_temp)
    except OSError as exc:
        fail(f"Could not stage cluster kubeconfig: {exc.strerror or exc}")

    print("Cluster kubeconfig staged in RUNNER_TEMP.")


if __name__ == "__main__":
    main()
