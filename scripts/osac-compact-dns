#!/usr/bin/env bash
# Publish a compact clone's API and ingress VIPs to the runner host resolver.
# The guests use their libvirt network's DNS; host-side CI needs route names too.
set -euo pipefail

[[ $# -eq 2 ]] || { echo "Usage: osac-compact-dns {add|remove} CLONE_ID" >&2; exit 2; }
action="$1"
clone_id="$2"
[[ "${clone_id}" =~ ^[a-z0-9]([a-z0-9-]{0,29}[a-z0-9])?$ ]] ||
  { echo "Invalid compact clone ID: ${clone_id}" >&2; exit 2; }

domain="test-infra-cluster-${clone_id}.redhat.com"
config="/etc/NetworkManager/dnsmasq.d/osac-compact-${clone_id}.conf"
exec 9>/var/lock/osac-compact-dns.lock
flock --exclusive 9

case "${action}" in
  add)
    kubeconfig="/var/lib/libvirt/images/${clone_id}/clone.kubeconfig"
    if [[ -x /usr/local/bin/oc ]]; then
      oc_bin=/usr/local/bin/oc
    elif [[ -x /usr/bin/oc ]]; then
      oc_bin=/usr/bin/oc
    else
      echo "OpenShift CLI not installed" >&2
      exit 1
    fi
    server=$("${oc_bin}" config view --kubeconfig="${kubeconfig}" --minify -o jsonpath='{.clusters[0].cluster.server}')
    if [[ ! "${server}" =~ ^https://192\.168\.([0-9]{1,3})\.5:6443$ ]]; then
      echo "Unexpected compact API endpoint" >&2
      exit 1
    fi
    subnet="${BASH_REMATCH[1]}"
    (( subnet >= 1 && subnet <= 254 )) || { echo "Invalid compact subnet: ${subnet}" >&2; exit 1; }

    temp=$(mktemp "${config}.XXXXXX")
    trap 'rm -f "${temp}"' EXIT
    printf 'address=/api.%s/192.168.%s.5\naddress=/api-int.%s/192.168.%s.5\naddress=/apps.%s/192.168.%s.10\n' \
      "${domain}" "${subnet}" "${domain}" "${subnet}" "${domain}" "${subnet}" > "${temp}"
    chmod 0644 "${temp}"
    mv -f "${temp}" "${config}"
    nmcli general reload
    ;;
  remove)
    rm -f "${config}"
    nmcli general reload
    ;;
  *)
    echo "Usage: osac-compact-dns {add|remove} CLONE_ID" >&2
    exit 2
    ;;
esac
