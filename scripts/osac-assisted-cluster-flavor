  if [[ "${API_ADDRESS}" =~ ^192\.168\.([0-9]{1,3})\.100$ ]]; then
    SOURCE_PRIMARY_SUBNET=${BASH_REMATCH[1]}
  else
    fail "Expected MNO API VIP on a 192.168.x.100 primary subnet, found '${API_ADDRESS}'."
  fi

  echo "Capturing compact flavor from healthy source cluster."
  python3 "${CLUSTER_TOOL_DIR}/scripts/capture_compact_flavor.py" \
    --flavor "${FLAVOR_NAME}" \
    --source-cluster "${CLUSTER_ID}" \
