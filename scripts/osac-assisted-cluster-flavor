baremetal_tf = root / "terraform_files/baremetal/main.tf"
baremetal_text = baremetal_tf.read_text()
name_lines = re.findall(r"(?m)^[ \t]*name[ \t]*=.*var\.load_balancer_type.*$", baremetal_text)
master_name_lines = [line for line in name_lines if "master-secondary" in line]
old_master_name = '"${var.cluster_name}-master-${count.index}"'
new_master_name = '"${var.cluster_name}-master-0-${count.index}"'
if len(master_name_lines) != 1 or master_name_lines[0].count(old_master_name) != 2:
    raise SystemExit(f"Could not find the master domain name in {baremetal_tf}")
baremetal_text = baremetal_text.replace(
    master_name_lines[0],
    master_name_lines[0].replace(old_master_name, new_master_name),
    1,
)
hostname_pattern = r'(?m)^([ \t]*hostname[ \t]*=[ \t]*var\.slave_interfaces \? null : )"\$\{var\.cluster_name\}-master-\$\{count\.index\}"'
