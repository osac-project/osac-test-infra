from pathlib import Path
import re
import sys

root = Path(sys.argv[1])
host_tf = root / "terraform_files/baremetal_host/main.tf"
host_text = host_tf.read_text()
host_text, scsi_count = re.subn(r"(?m)^([ \t]*)scsi[ \t]*=[ \t]*true[ \t]*$", r"\1scsi = false", host_text)
if scsi_count != 2:
    raise SystemExit(f"Expected 2 SCSI disk settings in {host_tf}, found {scsi_count}")
