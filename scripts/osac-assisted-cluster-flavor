    hostname_pattern,
    r'\1"master-0-${count.index}"',
    baremetal_text,
)
if hostname_count < 1:
    raise SystemExit(f"Could not set compact master hostnames in {baremetal_tf}")
baremetal_tf.write_text(baremetal_text)
PY
fi

