wait_for_cluster_health() {
  echo "Waiting for all source-cluster nodes to become Ready..."
  local deadline=$((SECONDS + 3600))
  until oc wait nodes --all --for=condition=Ready --timeout=2m; do
    (( SECONDS < deadline )) || fail "Source nodes did not become Ready within 60 minutes."
    echo "Source API or nodes are still recovering; retrying node readiness."
    sleep 15
  done

  deadline=$((SECONDS + 3600))
  until oc wait mcp/master --for=condition=Updated --timeout=2m; do
    (( SECONDS < deadline )) || fail "Source master MCP did not become Updated within 60 minutes."
    echo "Source API or master MCP is still recovering; retrying MCP readiness."
    sleep 15
  done

  echo "Waiting for all ClusterOperators to become healthy and quiet..."
  for attempt in $(seq 1 60); do
    if oc get co -o json | jq -e '
      (.items | length > 0) and
      all(.items[];
        ([.status.conditions[] | select(.type == "Available") | .status][0] == "True") and
        ([.status.conditions[] | select(.type == "Progressing") | .status][0] == "False") and
        ([.status.conditions[] | select(.type == "Degraded") | .status][0] == "False")
      )' >/dev/null; then
      return
    fi
    if [[ "${attempt}" == 60 ]]; then
      echo "::error::ClusterOperators did not become healthy within 30 minutes."
      return 1
    fi
    sleep 30
  done
}

wait_for_cluster_health

if [[ "${CLUSTER_TOPOLOGY}" == "sno" ]]; then
  domain="${DOMAIN_PREFIX}-master-0"
  vcpus=$(virsh dominfo "${domain}" | awk -F: '/^CPU\(s\):/ {gsub(/^[ \t]+/, "", $2); print $2}')
  memory_kib=$(virsh dominfo "${domain}" | awk -F: '/^Max memory:/ {gsub(/[^0-9]/, "", $2); print $2}')
  interfaces=$(virsh domiflist "${domain}" | awk 'NR > 2 && NF >= 5 {count++} END {print count+0}')
  if [[ "${vcpus}" != 16 || "${memory_kib}" != 67108864 || "${interfaces}" != 2 ]]; then
    echo "::error::SNO source VM '${domain}' does not match the 16-vCPU, 64-GiB, two-NIC profile."
    exit 1
  fi
  for target in sda sdb; do
    volume_name=$(virsh domblklist "${domain}" --details | awk -v target="${target}" '$2 == "disk" && $3 == target {print $4}')
    disk=$(virsh vol-path --pool "${DOMAIN_PREFIX}" "${volume_name}" 2>/dev/null || true)
    if [[ -z "${volume_name}" || -z "${disk}" || ! -f "${disk}" ]]; then
      echo "::error::Could not find the ${target} disk on SNO source VM '${domain}'."
      exit 1
    fi
    size=$(qemu-img info --force-share --output=json "${disk}" | jq -r '."virtual-size"')
    if [[ "${size}" != 100000000000 ]]; then
      echo "::error::SNO source disk ${target} is ${size} bytes; expected 100000000000."
      exit 1
    fi
  done

  python3 "${CLUSTER_TOOL_PATH}" snapshot \
    --name "${FLAVOR_NAME}" \
    --source "${CLUSTER_ID}" \
    --server local
else
  TFVARS="${ATI_DIR}/build/terraform/${DOMAIN_PREFIX}/baremetal/terraform.tfvars.json"
  PRIMARY_NETWORK=$(jq -r '.libvirt_network_name // empty' "${TFVARS}")
  if [[ -z "${PRIMARY_NETWORK}" ]]; then
    echo "::error::Could not find the source primary network in ${TFVARS}."
    exit 1
  fi

  for index in 0 1 2; do
    domain="${DOMAIN_PREFIX}-master-0-${index}"
    virsh shutdown "${domain}"
  done
  for index in 0 1 2; do
    domain="${DOMAIN_PREFIX}-master-0-${index}"
    for attempt in $(seq 1 60); do
      state=$(virsh domstate "${domain}" 2>/dev/null || true)
      [[ "${state}" == "shut off" ]] && break
      if [[ "${attempt}" == 60 ]]; then
        echo "::error::Timed out shutting down ${domain} for spare-disk resize."
        exit 1
      fi
      sleep 5
    done
  done

  python3 - "${DOMAIN_PREFIX}" "${PRIMARY_NETWORK}" <<'PY'
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET

prefix, primary_network = sys.argv[1:]
for index in range(3):
    domain = f"{prefix}-master-0-{index}"
    xml = subprocess.check_output(["virsh", "dumpxml", domain], text=True)
    root = ET.fromstring(xml)
    devices = root.find("devices")
    interfaces = devices.findall("interface")
    primary = [
        interface
        for interface in interfaces
        if (interface.find("source") is not None)
        and interface.find("source").get("network") == primary_network
    ]
    if len(interfaces) != 2 or len(primary) != 1:
        raise SystemExit(f"Expected two NICs and one primary network on {domain}")
    for interface in interfaces:
        if interface not in primary:
            devices.remove(interface)
    with tempfile.NamedTemporaryFile(mode="w", suffix=".xml") as xml_file:
        ET.ElementTree(root).write(xml_file, encoding="unicode")
        xml_file.flush()
        subprocess.run(["virsh", "define", xml_file.name], check=True)
PY

  for index in 0 1 2; do
    domain="${DOMAIN_PREFIX}-master-0-${index}"

    spare_volume=$(virsh domblklist "${domain}" --details | awk '$2 == "disk" && $3 == "vdb" {print $4}')
    spare_disk=$(virsh vol-path --pool "${DOMAIN_PREFIX}" "${spare_volume}" 2>/dev/null || true)
    if [[ -z "${spare_volume}" || -z "${spare_disk}" || ! -f "${spare_disk}" ]]; then
      echo "::error::Could not find the vdb disk for ${domain}."
      exit 1
    fi
    qemu-img resize "${spare_disk}" 141733920768
  done
  for index in 0 1 2; do
    domain="${DOMAIN_PREFIX}-master-0-${index}"
    virsh start "${domain}"
  done
  wait_for_cluster_health

  API_SERVER_NAME="api.${DOMAIN_PREFIX}.redhat.com"
