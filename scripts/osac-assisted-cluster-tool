#!/usr/bin/env bash
# Narrow polkit entry point for cluster-tool operations used by the Assisted
# flavor workflow. The runner can select an operation, not an executable or
# arbitrary cluster-tool arguments.
set -euo pipefail

CLUSTER_TOOL=/usr/local/bin/cluster-tool
RUNNER_USER="${OSAC_CALLER_USER:-}"

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

[[ "${EUID}" -eq 0 && -n "${RUNNER_USER}" && "${PKEXEC_UID:-}" == "${OSAC_CALLER_UID:-}" &&
   "$(id -u "${RUNNER_USER}" 2>/dev/null)" == "${PKEXEC_UID:-}" ]] ||
  fail "This helper must be invoked through osac-privileged."
[[ -x "${CLUSTER_TOOL}" ]] || fail "cluster-tool is not installed at ${CLUSTER_TOOL}."

validate_flavor() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9._-]{0,62}$ ]] || fail "Invalid flavor name."
}

validate_clone() {
  [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,29}[a-z0-9])?$ ]] || fail "Invalid clone name."
}

case "${1:-}" in
  flavors)
    [[ $# -eq 1 ]] || fail "Usage: osac-assisted-cluster-tool flavors"
    exec /usr/bin/python3 "${CLUSTER_TOOL}" flavors
    ;;
  delete-flavor)
    [[ $# -eq 2 ]] || fail "Usage: osac-assisted-cluster-tool delete-flavor FLAVOR"
    validate_flavor "$2"
    exec /usr/bin/python3 "${CLUSTER_TOOL}" flavors --delete "$2"
    ;;
  destroy)
    [[ $# -eq 2 ]] || fail "Usage: osac-assisted-cluster-tool destroy CLONE"
    validate_clone "$2"
    exec /usr/bin/python3 "${CLUSTER_TOOL}" destroy "$2"
    ;;
  boot)
    [[ $# -eq 4 ]] ||
      fail "Usage: osac-assisted-cluster-tool boot FLAVOR CLONE PULL_SECRET"
    validate_flavor "$2"
    validate_clone "$3"

    runner_home=$(getent passwd "${RUNNER_USER}" | cut -d: -f6)
    secret="$4"
    temp_dir="${secret%/pull-secret.json}"
    relative="${temp_dir#${runner_home}/action-runners/}"
    runner_name="${relative%%/*}"
    [[ "${relative}" == "${runner_name}/_work/_temp" &&
       "${runner_name}" =~ ^runner-[1-9][0-9]*$ ]] ||
      fail "Pull secret must be in a registered GitHub runner temp directory."
    for dir in "${runner_home}/action-runners" "${runner_home}/action-runners/${runner_name}" \
               "${runner_home}/action-runners/${runner_name}/_work" "${temp_dir}"; do
      [[ -d "${dir}" && ! -L "${dir}" ]] ||
        fail "Invalid runner temp directory: ${dir}"
    done
    [[ -f "${secret}" && ! -L "${secret}" && -s "${secret}" &&
       "$(stat -c '%u' -- "${temp_dir}")" == "${OSAC_CALLER_UID}" &&
       "$(stat -c '%u' -- "${secret}")" == "${OSAC_CALLER_UID}" ]] ||
      fail "Pull secret must be a runner-owned regular file in RUNNER_TEMP."
    exec /usr/bin/python3 "${CLUSTER_TOOL}" boot \
      --flavor "$2" --name "$3" --pull-secret "${secret}"
    ;;
  *)
    fail "Unsupported operation. Use flavors, delete-flavor, destroy, or boot."
    ;;
esac
