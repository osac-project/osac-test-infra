[0.00461, "o", "\u001b[1;37m==> Scene 1: One outer cluster, shared infrastructure\u001b[0m\r\n\u001b[36m# One copy of PostgreSQL, Kafka, Keycloak, cert-manager and AAP. No per-run copies.\u001b[0m\r\n"]
