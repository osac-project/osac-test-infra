#!/bin/bash
# Fix VPN routes that conflict with local lab bridges.
# The VPN server pushes routes for virbr0's, br-mgmt's, and the softgate
# mgmt subnet's prefixes via tun0 (with a malformed gateway -- the peer's
# own netmask), which overrides the connected routes needed to reach
# mgmt-server, br-mgmt, and the softgates. See docs/troubleshooting.md #4.
sleep 3

# virbr0 (mgmt-server, isp-server)
ip route del 192.168.122.0/24 via 255.255.255.0 dev tun0 2>/dev/null || true
ip route add 192.168.122.0/24 dev virbr0 proto kernel scope link src 192.168.122.1 2>/dev/null || true

# br-mgmt's own connected subnet
ip route del {{ mgmt_bridge_network }} via 255.255.255.0 dev tun0 2>/dev/null || true
ip route add {{ mgmt_bridge_network }} dev {{ mgmt_bridge_name }} proto kernel scope link src {{ mgmt_bridge_ip }} 2>/dev/null || true

# softgate/OOB mgmt subnet (rides on br-mgmt but is not br-mgmt's own address range)
ip route del {{ ns_fabric.mgmt_subnet }} via 255.255.255.0 dev tun0 2>/dev/null || true
ip route add {{ ns_fabric.mgmt_subnet }} dev {{ mgmt_bridge_name }} 2>/dev/null || true
