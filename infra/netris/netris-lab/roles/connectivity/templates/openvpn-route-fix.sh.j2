#!/bin/bash
# Fix VPN route that conflicts with virbr0.
# The VPN server pushes a route for 192.168.122.0/24 via tun0,
# which overrides the virbr0 connected route needed for mgmt-server access.
sleep 3
ip route del 192.168.122.0/24 dev tun0 2>/dev/null || true
ip route replace 192.168.122.0/24 dev virbr0 proto kernel scope link src 192.168.122.1
ip route del 192.168.16.0/20 dev tun0 2>/dev/null || true
ip route replace 192.168.16.0/20 dev {{ mgmt_bridge_name }} proto kernel scope link src {{ mgmt_bridge_cidr | ansible.utils.ipaddr('address') }}
