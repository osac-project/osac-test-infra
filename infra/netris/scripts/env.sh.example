#!/usr/bin/env bash
# Copy this file to env.sh and fill in real values.
# Usage: source scripts/env.sh && make deploy-bg-full
#
# For bare-metal deployments, add EXTRA_VARS to override infra_provider:
#   export EXTRA_VARS="infra_provider=onprem"

export SERVER=192.168.56.XX
export PASSWORD='CHANGEME'
export LAB_NAME=mylab

export PULL_SECRET=/path/to/pull-secret.txt
export LICENSE_KEY=/path/to/license.key
export LICENSE_ZIP=/path/to/license.zip

export AWS_ACCESS_KEY_ID=CHANGEME
export AWS_SECRET_ACCESS_KEY=CHANGEME

# Uncomment for bare-metal RHEL deployments
# export EXTRA_VARS="infra_provider=onprem"
