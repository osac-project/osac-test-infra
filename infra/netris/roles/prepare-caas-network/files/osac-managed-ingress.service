[Unit]
Description=Configure OSAC tenant ingress networking
Wants=NetworkManager-wait-online.service
After=NetworkManager-wait-online.service
Before=nodeip-configuration.service ovs-configuration.service

[Service]
Type=oneshot
ExecStart=/etc/osac-ingress/prepare-ingress.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
