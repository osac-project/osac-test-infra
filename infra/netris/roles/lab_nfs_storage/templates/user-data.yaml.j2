#cloud-config
hostname: {{ lab_nfs_vm_name }}
fqdn: {{ lab_nfs_vm_name }}.lab
manage_etc_hosts: true
users:
  - name: {{ lab_nfs_ssh_user }}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - {{ _lab_nfs_pub.content | b64decode | trim }}
package_update: true
packages:
  - nfs-kernel-server
  - nfs-common
  - tcpdump
write_files:
  - path: /etc/exports
    owner: root:root
    permissions: "0644"
    content: |
      {% for cidr in lab_nfs_client_cidrs %}
      {{ lab_nfs_export }} {{ cidr }}(rw,sync,no_subtree_check,insecure,no_root_squash)
      {% endfor %}
  - path: /etc/nfs.conf.d/99-osac.conf
    owner: root:root
    permissions: "0644"
    content: |
      [nfsd]
      vers3 = no
      vers4.1 = yes
  - path: /etc/systemd/system/osac-nfs-clients.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Log NFS client source addresses
      After=network-online.target nfs-server.service
      Wants=network-online.target
      [Service]
      ExecStart=/usr/sbin/tcpdump -nn -l -i any 'tcp port 2049 and tcp[tcpflags] & tcp-syn != 0'
      StandardOutput=append:{{ lab_nfs_client_log }}
      Restart=always
      RestartSec=2
      [Install]
      WantedBy=multi-user.target
runcmd:
  - mkdir -p {{ lab_nfs_export }}
  - chmod 0777 {{ lab_nfs_export }}
  - touch {{ lab_nfs_client_log }}
  - chmod 0644 {{ lab_nfs_client_log }}
  - exportfs -ra
  - systemctl enable --now nfs-server
  - systemctl enable --now osac-nfs-clients
