version: 2
ethernets:
  storage0:
    # Match by name: libvirt assigns a unique MAC so two lab runs cannot
    # collide, and this VM has exactly one NIC.
    match:
      name: "en*"
    set-name: storage0
    dhcp4: false
    addresses:
      - {{ lab_nfs_server_ip }}/{{ netris_storage_endpoint_cidr | ansible.utils.ipaddr('prefix') }}
    routes:
      - to: default
        via: {{ lab_nfs_bridge_ip }}
    nameservers:
      addresses:
        - {{ lab_nfs_dns_server }}
