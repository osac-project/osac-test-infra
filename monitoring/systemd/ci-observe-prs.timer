# Systemd user timer for the ci-observe pull-request backfill.
# Installed by monitoring-setup.sh to ~/.config/systemd/user/ci-observe-prs.timer
#
# Runs hourly, five minutes past the hour, so a pull request merged now is on
# the Pull requests page within the hour instead of the next day. The random
# delay spreads the GitHub calls of several machines. Persistent=true means a
# missed run starts when the machine comes back; the two-hour overlap of each
# incremental pass means a late run still sees what it missed.

[Unit]
Description=Run the ci-observe pull-request backfill hourly

[Timer]
OnCalendar=*-*-* *:05:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
