# Systemd user timer for the ci-observe per-test rollup.
# Installed by monitoring-setup.sh to ~/.config/systemd/user/ci-observe-trends.timer
#
# Runs hourly at 25 past, so a finished run's tests reach the pages within the
# hour and the archive never falls behind the exporter's 30 days. Persistent
# means a missed pass (machine down) runs when the machine comes back; a run
# whose artifact is still inside GitHub's 30-day window is read late, not
# lost.

[Unit]
Description=Run the ci-observe per-test rollup hourly

[Timer]
OnCalendar=*-*-* *:25:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
