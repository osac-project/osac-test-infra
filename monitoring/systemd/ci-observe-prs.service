# Daily ci-observe pull-request backfill.
# Installed by monitoring-setup.sh to ~/.config/systemd/user/ci-observe-prs.service
#
# Runs inside the workflow-exporter container because that container has the
# GitHub token, the `requests` dependency and the /data volume where prs.db
# lives. One pass per day is enough: the backfill stores a pull request once
# and never refetches it unless --force is given.

[Unit]
Description=ci-observe pull-request backfill
After=workflow-exporter.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman exec workflow-exporter python3 /app/ci_observe_prs.py --days 60
