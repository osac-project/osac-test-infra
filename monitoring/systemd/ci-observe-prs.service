# Hourly ci-observe pull-request backfill.
# Installed by monitoring-setup.sh to ~/.config/systemd/user/ci-observe-prs.service
#
# Runs inside the workflow-exporter container because that container has the
# GitHub token, the `requests` dependency and the /data volume where prs.db
# lives. --mode auto runs an incremental pass every hour and a full pass with
# the prune once a day, so a stored pull request is not refetched every hour
# and the file still covers the retention window: 90 days, as long as the
# run archive the Overview and the Pull requests page compare against.

[Unit]
Description=ci-observe pull-request backfill
After=workflow-exporter.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman exec workflow-exporter python3 /app/ci_observe_prs.py --days 90 --mode auto
