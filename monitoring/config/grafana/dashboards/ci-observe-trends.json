    {
      "type": "stat",
      "id": 7,
      "title": "Pass rate, all workflow runs, selected range (central Prometheus)",
      "description": "Successful completed runs divided by all completed runs, captured or not. Window: the dashboard time range. Counters reset when the exporter restarts, so a range spanning a restart reads slightly low.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 3,
          "noValue": "no data in range",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(github_actions_completed_runs_total{org=\"osac-project\", conclusion=\"success\"}[$__range])) / sum(increase(github_actions_completed_runs_total{org=\"osac-project\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "id": 8,
      "title": "Completed runs, all workflow runs, selected range (central Prometheus)",
      "description": "Every completed workflow run in the window, captured or not. This is the denominator of the pass rate beside it. Window: the dashboard time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "no data in range"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(github_actions_completed_runs_total{org=\"osac-project\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "id": 9,
      "title": "Run duration p50, all workflow runs, selected range (central Prometheus)",
      "description": "Median completed-run duration from the exporter's histogram. Population: all workflow runs, captured or not. Window: the dashboard time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "no data in range"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(github_actions_run_duration_seconds_bucket{org=\"osac-project\"}[$__range])))",
          "instant": true,
          "range": false
