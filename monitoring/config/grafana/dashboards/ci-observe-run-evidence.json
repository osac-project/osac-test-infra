    {
      "title": "Native test result",
      "description": "The JUnit results parsed from the run's osac-logs full-install artifact, fetched on demand and cached for 15 minutes. The artifact name carries the suite (osac-logs-full-install-<run id> for VMaaS, osac-logs-<suite>-full-install-<run id> for BMaaS and CaaS); any of them is accepted. GitHub keeps workflow artifacts for 7 days. When the status is anything but available, the counts show no result rather than a number: a missing artifact must never look like a green zero.",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "collapsed": false,
      "panels": []
    },
