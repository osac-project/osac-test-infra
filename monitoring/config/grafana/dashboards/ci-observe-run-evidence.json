    {
      "title": "Failed tests",
      "description": "At most the first 100 failed tests are listed; messages are capped at 2000 characters and stack traces are never included. Empty when the run passed, or when the artifact is missing, expired or too large.",
      "type": "table",
      "id": 5,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "workflow-api"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No failed tests, or no JUnit evidence: check the JUnit summary Status row."
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "classname"
            },
