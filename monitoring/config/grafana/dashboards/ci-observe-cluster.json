          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (k8s_pod_name) (k8s_pod_cpu_usage{osac_ci_capture_id=\"$capture_id\"}))",
          "legendFormat": "pods",
          "range": true,
          "instant": false
        }
      ]
    },
