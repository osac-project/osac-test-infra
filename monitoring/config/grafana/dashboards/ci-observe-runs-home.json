            "uid": "ci-observe-traces"
          },
          "refId": "A",
          "queryType": "traceql",
          "tableType": "spans",
          "query": "{ resource.service.name = \"tests\" && .pytest.span_type = \"test\" && name !~ \".*::(setup|call|teardown)\" && resource.\"osac.ci.capture_id\" =~ \".+\" }",
          "limit": 1000,
          "spss": 100
        }
