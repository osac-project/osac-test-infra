      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "ci-observe-traces"
          },
          "refId": "A",
          "queryType": "traceql",
          "tableType": "spans",
          "query": "{ name = \"test run\" && (status = ok || status = error) && resource.\"osac.ci.capture_id\" =~ \".+\" && resource.\"osac.ci.suite\" =~ \".+\" && resource.\"osac.ci.pr\" =~ \".+\" }",
          "limit": 1000,
          "spss": 100
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "ci-observe-traces"
          },
          "refId": "B",
          "queryType": "traceql",
          "tableType": "spans",
          "query": "{ resource.service.name = \"tests\" && .pytest.span_type = \"test\" && name !~ \".*::(setup|call|teardown)\" && resource.\"osac.ci.capture_id\" =~ \".+\" }",
          "limit": 1000,
          "spss": 100
        }
      ],
      "transformations": [
        {
          "id": "groupBy",
          "filter": {
            "id": "byRefId",
            "options": "B"
          },
          "options": {
            "fields": {
              "osac.ci.capture_id": {
                "aggregations": [],
                "operation": "groupby"
              },
              "pytest.span_type": {
                "aggregations": [
                  "count"
                ],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "osac.ci.capture_id",
            "mode": "inner"
          }
        }
      ]
    }
