{
  "annotations": {
    "list": []
  },
  "description": "Recent E2E runs.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [
    {
      "title": "Pull requests",
      "type": "link",
      "url": "/d/ci-observe-pull-requests/ci-observe-e28094-pull-requests"
    },
    {
      "title": "Test history",
      "type": "link",
      "url": "/d/ci-observe-trends/ci-observe-e28094-trends"
    }
  ],
  "panels": [
    {
      "type": "text",
      "id": 1,
      "title": "E2E runs",
      "description": "",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Recent E2E runs. Filter by repository, suite or result above, or use a column filter. A row with no test data opens GitHub. **No** under Recorded means the job sent no test data; Netris, full-regression and agentless jobs cannot record yet."
      },
      "targets": []
    },
    {
      "type": "table",
      "id": 12,
      "title": "Recent E2E runs, last $days days",
      "description": "",
      "gridPos": {
        "h": 22,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "workflow-api"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          },
          "noValue": "No E2E runs match these filters"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Run"
              },
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true,
                  "dynamicHeight": true
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the run page, or GitHub when no test data arrived",
                    "url": "${__data.fields.details_url}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "conclusion"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Result"
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "text": "Passed",
                        "color": "green"
                      },
                      "failure": {
                        "text": "Failed",
                        "color": "red"
                      },
                      "cancelled": {
                        "text": "Canceled",
                        "color": "orange"
                      },
                      "skipped": {
                        "text": "Skipped",
                        "color": "text"
                      },
                      "timed_out": {
                        "text": "Timed out",
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "capture_state"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Recorded"
              },
              {
                "id": "custom.width",
                "value": 105
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "capture": {
                        "text": "Yes",
                        "color": "green"
                      },
                      "not collected": {
                        "text": "No",
                        "color": "orange"
                      },
                      "unknown": {
                        "text": "Unknown",
                        "color": "text"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "created_at"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Started"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "GitHub"
              },
              {
                "id": "custom.width",
                "value": 75
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open workflow run on GitHub",
                    "url": "${__value.raw}"
                  }
                ]
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".*",
                      "result": {
                        "text": "Open"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "workflow"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Workflow"
              },
              {
                "id": "custom.width",
                "value": 240
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true,
                  "dynamicHeight": true
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "repo"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Repository"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "branch"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Branch"
              },
              {
                "id": "custom.width",
                "value": 200
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true,
                  "dynamicHeight": true
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trigger"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Started by"
              },
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true,
                  "dynamicHeight": true
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "scheduled": {
                        "text": "Scheduled",
                        "color": "text",
                        "index": 0
                      },
                      "manual": {
                        "text": "Manual",
                        "color": "text",
                        "index": 1
                      },
                      "push (live-push)": {
                        "text": "Push",
                        "color": "text",
                        "index": 2
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^merge queue.*",
                      "result": {
                        "text": "Merge queue"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pr"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "PR"
              },
              {
                "id": "custom.width",
                "value": 80
              },
              {
                "id": "noValue",
                "value": ""
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open this pull request",
                    "url": "/d/ci-observe-pull-requests/ci-observe-pull-requests?var-pr_number=${__data.fields.pr_number}&var-pr_repo=${__data.fields.repo}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pr_number"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "details_url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Started",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://127.0.0.1:9103/api/ci-observe/runs?days=${days}&repo=${repo}&suite=${suite}&result=${result}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "$.runs",
          "columns": [
            {
              "selector": "id",
              "text": "id",
              "type": "string"
            },
            {
              "selector": "workflow",
              "text": "workflow",
              "type": "string"
            },
            {
              "selector": "repo",
              "text": "repo",
              "type": "string"
            },
            {
              "selector": "pr",
