              "type": "string"
            },
            {
              "selector": "trigger",
              "text": "trigger",
              "type": "string"
            },
            {
              "selector": "conclusion",
              "text": "conclusion",
              "type": "string"
            },
            {
              "selector": "capture_state",
              "text": "capture_state",
              "type": "string"
            },
            {
              "selector": "created_at",
              "text": "created_at",
              "type": "string"
            },
            {
              "selector": "url",
              "text": "url",
              "type": "string"
            },
            {
              "selector": "pr_number",
              "text": "pr_number",
              "type": "string"
            },
            {
              "selector": "details_url",
              "text": "details_url",
              "type": "string"
            }
          ]
        }
      ]
    }
  ],
