    {
      "type": "stat",
      "id": 8,
      "title": "Missing session span",
      "description": "Captures that recorded test spans but whose session span never arrived (partial telemetry). Their outcome is unknown - not passed. A capture counts as missing when none of its test spans carry the session trace name, so the session span never reached the backend. Listed in the table below.",
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 16,
        "y": 11
      },
      "datasource": {
        "type": "tempo",
        "uid": "ci-observe-traces"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
