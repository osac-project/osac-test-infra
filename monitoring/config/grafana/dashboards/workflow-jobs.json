{
  "annotations": { "list": [] },
  "description": "Operational view of assigned-machine OSAC workflow health, queue saturation, reliability, failure hotspots, duration bottlenecks, and active E2E runs. Run-count panels exclude jobs without a dedicated machine. Queue colors: red = Queued (All), blue = In-Progress (All), orange = selected-category queue, cyan = selected-category in-progress.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Success",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "workflow-api" },
      "fieldConfig": {
        "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{
        "refId": "A",
        "type": "json",
        "source": "url",
        "format": "table",
        "url": "http://127.0.0.1:9103/api/counts?category=${category:text}&repo=${repo_filter}&workflow_name=${workflow_name}&runner=${machine}&job_type=${job_type}&failure_reason=${failure_reason}&search=${search:percentencode}&since=${__from:date:iso}&until=${__to:date:iso}",
        "url_options": { "method": "GET", "data": "" },
        "columns": [{ "selector": "success", "text": "Success", "type": "number" }]
      }]
    },
    {
      "id": 2,
      "title": "Failed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "workflow-api" },
      "fieldConfig": {
        "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{
        "refId": "A",
        "type": "json",
        "source": "url",
        "format": "table",
        "url": "http://127.0.0.1:9103/api/counts?category=${category:text}&repo=${repo_filter}&workflow_name=${workflow_name}&runner=${machine}&job_type=${job_type}&failure_reason=${failure_reason}&search=${search:percentencode}&since=${__from:date:iso}&until=${__to:date:iso}",
        "url_options": { "method": "GET", "data": "" },
        "columns": [{ "selector": "failure", "text": "Failed", "type": "number" }]
      }]
    },
    {
      "id": 3,
      "title": "Cancelled",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "workflow-api" },
      "fieldConfig": {
        "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] } },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{
        "refId": "A",
        "type": "json",
        "source": "url",
        "format": "table",
        "url": "http://127.0.0.1:9103/api/counts?category=${category:text}&repo=${repo_filter}&workflow_name=${workflow_name}&runner=${machine}&job_type=${job_type}&failure_reason=${failure_reason}&search=${search:percentencode}&since=${__from:date:iso}&until=${__to:date:iso}",
        "url_options": { "method": "GET", "data": "" },
        "columns": [{ "selector": "cancelled", "text": "Cancelled", "type": "number" }]
      }]
    },
    {
      "id": 4,
      "title": "Queued Now",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "workflow-api" },
      "fieldConfig": {
        "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{
        "refId": "A",
        "type": "json",
        "source": "url",
        "format": "table",
        "url": "http://127.0.0.1:9103/api/counts?category=${category:text}&repo=${repo_filter}&workflow_name=${workflow_name}&runner=${machine}&job_type=${job_type}&failure_reason=${failure_reason}&search=${search:percentencode}",
        "url_options": { "method": "GET", "data": "" },
        "columns": [{ "selector": "queued", "text": "Queued", "type": "number" }]
      }]
    },
    {
      "id": 5,
      "title": "In Progress Now",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "workflow-api" },
      "fieldConfig": {
        "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{
        "refId": "A",
        "type": "json",
        "source": "url",
        "format": "table",
        "url": "http://127.0.0.1:9103/api/counts?category=${category:text}&repo=${repo_filter}&workflow_name=${workflow_name}&runner=${machine}&job_type=${job_type}&failure_reason=${failure_reason}&search=${search:percentencode}",
        "url_options": { "method": "GET", "data": "" },
        "columns": [{ "selector": "in_progress", "text": "In Progress", "type": "number" }]
      }]
    },
    {
      "id": 6,
      "title": "Failure Rate",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "workflow-api" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.3 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [{
        "refId": "A",
        "type": "json",
        "source": "url",
        "format": "table",
        "url": "http://127.0.0.1:9103/api/counts?category=${category:text}&repo=${repo_filter}&workflow_name=${workflow_name}&runner=${machine}&job_type=${job_type}&failure_reason=${failure_reason}&search=${search:percentencode}&since=${__from:date:iso}&until=${__to:date:iso}",
        "url_options": { "method": "GET", "data": "" },
        "columns": [{ "selector": "failure_rate", "text": "Failure Rate", "type": "number" }]
      }]
    },
    {
      "id": 7,
      "title": "Queue Depth & In-Progress Runs",
      "description": "Unified queue saturation view. The all-category series stays visible for fleet capacity, while the second pair follows the Category filter (E2E by default).",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "spanNulls": false } },
        "overrides": [
        { "matcher": { "id": "byRegexp", "options": "/^Queued \\((?!All\\)).+\\)$/" }, "properties": [{ "id": "color", "value": { "fixedColor": "#ff9800", "mode": "fixed" } }] },
        { "matcher": { "id": "byRegexp", "options": "/^In-Progress \\((?!All\\)).+\\)$/" }, "properties": [{ "id": "color", "value": { "fixedColor": "#00e5ff", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Queued (All)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#f2495c", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "In-Progress (All)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#5794f2", "mode": "fixed" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "github_actions_queued_runs_org", "legendFormat": "Queued (All)" },
        { "refId": "B", "expr": "github_actions_in_progress_runs_org", "legendFormat": "In-Progress (All)" },
        { "refId": "C", "expr": "sum(github_actions_queued_runs_by_category{category=~\"${category:regex}\"})", "legendFormat": "Queued (${category})" },
        { "refId": "D", "expr": "sum(github_actions_in_progress_runs_by_category{category=~\"${category:regex}\"})", "legendFormat": "In-Progress (${category})" }
      ]
    },
    {
      "id": 8,
      "title": "▸ WORKFLOW RELIABILITY & SUCCESS RATE",
      "description": "Percentage of successful completed runs by repository and workflow. Merge Similar defaults to No so the source repository remains visible in each label.",
      "type": "bargauge",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 11 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "workflow-api" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.9 }] }
        },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "namePlacement": "left", "sizing": "manual", "minVizHeight": 24, "maxVizHeight": 32, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/", "values": true }, "showUnfilled": true, "text": { "valueSize": 14 }, "textMode": "value_and_name" },
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["workflow", "success_rate"] } } },
        { "id": "rowsToFields", "options": { "mappings": [{ "fieldName": "workflow", "handlerKey": "field.name" }, { "fieldName": "success_rate", "handlerKey": "field.value" }] } }
      ],
      "targets": [{
        "refId": "A",
        "type": "json",
        "source": "url",
        "format": "table",
        "url": "http://127.0.0.1:9103/api/counts-by-workflow?category=${category:text}&repo=${repo_filter}&workflow_name=${workflow_name}&runner=${machine}&job_type=${job_type}&failure_reason=${failure_reason}&merge_similar=${merge_similar}&search=${search:percentencode}&since=${__from:date:iso}&until=${__to:date:iso}",
        "url_options": { "method": "GET", "data": "" },
        "columns": [
          { "selector": "workflow", "text": "workflow", "type": "string" },
          { "selector": "success_rate", "text": "success_rate", "type": "number" }
        ]
      }]
    },
    {
      "id": 9,
      "title": "▸ FAILING STEPS (TABLE)",
      "description": "Tabular view of failed steps returned by the exporter. The legacy Other bucket is excluded; failure counts use green, yellow, and orange severity colors.",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "workflow-api" },
      "fieldConfig": { "defaults": {}, "overrides": [
        { "matcher": { "id": "byName", "options": "step" }, "properties": [{ "id": "displayName", "value": "Failed Step" }, { "id": "custom.width", "value": 380 }] },
        { "matcher": { "id": "byName", "options": "count" }, "properties": [{ "id": "displayName", "value": "Failures" }, { "id": "custom.width", "value": 85 }, { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 2 }, { "color": "orange", "value": 5 }] } }] }
      ] },
      "options": { "showHeader": true, "cellHeight": "sm", "sortBy": [{ "displayName": "Failures", "desc": true }], "footer": { "show": true, "reducer": ["sum"] } },
      "transformations": [{ "id": "filterByValue", "options": { "filters": [{ "config": { "id": "notEqual", "options": { "value": "Other" } }, "fieldName": "step" }], "match": "all", "type": "include" } }],
      "targets": [{
        "refId": "A",
        "type": "json",
        "source": "url",
        "format": "table",
        "url": "http://127.0.0.1:9103/api/failed-steps?status=failure&category=${category:text}&repo=${repo_filter}&workflow_name=${workflow_name}&runner=${machine}&job_type=${job_type}&failure_reason=${failure_reason}&search=${search:percentencode}&since=${__from:date:iso}&until=${__to:date:iso}",
        "url_options": { "method": "GET", "data": "" },
        "columns": [{ "selector": "step", "text": "step", "type": "string" }, { "selector": "count", "text": "count", "type": "number" }]
      }]
    },
    {
      "id": 10,
      "title": "▸ EXECUTION DURATION ANALYSIS",
      "description": "Average run duration by job type; each bar is labeled with the job type. Values are shown in seconds and highlight durations over 10 minutes.",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "workflow-api" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 300 }, { "color": "orange", "value": 600 }, { "color": "red", "value": 1800 }] }
        },
        "overrides": []
      },
      "options": { "displayMode": "basic", "orientation": "horizontal", "namePlacement": "left", "sizing": "manual", "minVizHeight": 24, "maxVizHeight": 32, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/", "values": true }, "showUnfilled": true, "text": { "valueSize": 14 }, "textMode": "value_and_name" },
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["job_type", "avg_duration_s"] } } },
        { "id": "rowsToFields", "options": { "mappings": [{ "fieldName": "job_type", "handlerKey": "field.name" }, { "fieldName": "avg_duration_s", "handlerKey": "field.value" }] } }
      ],
      "targets": [{
        "refId": "A",
        "type": "json",
        "source": "url",
        "format": "table",
        "url": "http://127.0.0.1:9103/api/avg-duration-by-type?category=${category:text}&repo=${repo_filter}&workflow_name=${workflow_name}&runner=${machine}&job_type=${job_type}&failure_reason=${failure_reason}&status=${status_filter}&search=${search:percentencode}&since=${__from:date:iso}&until=${__to:date:iso}",
        "url_options": { "method": "GET", "data": "" },
        "columns": [
          { "selector": "job_type", "text": "job_type", "type": "string" },
          { "selector": "avg_duration_s", "text": "avg_duration_s", "type": "number" }
        ]
      }]
    },
    {
      "id": 11,
      "title": "Recent Runs — Active E2E Jobs",
      "description": "Recent E2E runs returned by the exporter; machine assignment and run status are shown when available.",
      "type": "table",
      "gridPos": { "h": 19, "w": 16, "x": 0, "y": 11 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "workflow-api" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "status" }, "properties": [{ "id": "displayName", "value": "Status" }, { "id": "custom.width", "value": 90 }, { "id": "mappings", "value": [{ "type": "value", "options": { "success": { "text": "Success", "color": "green" }, "failure": { "text": "Failed", "color": "red" }, "queued": { "text": "Queued", "color": "purple" }, "in_progress": { "text": "Running", "color": "blue" } } }] }, { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }] },
          { "matcher": { "id": "byName", "options": "repo" }, "properties": [{ "id": "displayName", "value": "Repository" }, { "id": "custom.width", "value": 130 }] },
          { "matcher": { "id": "byName", "options": "workflow" }, "properties": [{ "id": "displayName", "value": "Workflow" }, { "id": "custom.width", "value": 170 }, { "id": "links", "value": [{ "title": "Open in GitHub", "url": "${__data.fields.url}", "targetBlank": true }] }] },
          { "matcher": { "id": "byName", "options": "runner_name" }, "properties": [{ "id": "displayName", "value": "Machine" }, { "id": "custom.width", "value": 125 }] },
          { "matcher": { "id": "byName", "options": "branch" }, "properties": [{ "id": "displayName", "value": "Branch" }, { "id": "custom.width", "value": 135 }] },
          { "matcher": { "id": "byName", "options": "trigger" }, "properties": [{ "id": "displayName", "value": "Trigger" }, { "id": "custom.width", "value": 140 }] },
          { "matcher": { "id": "byName", "options": "pr_display" }, "properties": [{ "id": "displayName", "value": "PR" }, { "id": "custom.width", "value": 60 }, { "id": "links", "value": [{ "title": "Open PR", "url": "${__data.fields.pr_url}", "targetBlank": true }] }] },
          { "matcher": { "id": "byName", "options": "duration" }, "properties": [{ "id": "displayName", "value": "Duration" }, { "id": "custom.width", "value": 100 }] },
          { "matcher": { "id": "byName", "options": "actor" }, "properties": [{ "id": "displayName", "value": "Actor" }, { "id": "custom.width", "value": 110 }] },
          { "matcher": { "id": "byName", "options": "failed_step" }, "properties": [{ "id": "displayName", "value": "Failed Step" }, { "id": "custom.width", "value": 220 }] },
          { "matcher": { "id": "byName", "options": "created_at" }, "properties": [{ "id": "displayName", "value": "Started" }, { "id": "custom.width", "value": 145 }] },
          { "matcher": { "id": "byName", "options": "id" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "conclusion" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "event" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "duration_s" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "updated_at" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "run_number" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "run_attempt" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "url" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "pr_url" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "display_name" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "category" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "failure_reason" }, "properties": [{ "id": "custom.hidden", "value": true }] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "md", "sortBy": [], "footer": { "show": true, "reducer": ["count"], "countRows": true } },
      "targets": [{
        "refId": "A",
        "type": "json",
        "source": "url",
        "format": "table",
        "url": "http://127.0.0.1:9103/api/jobs?limit=200&active=true&category=e2e&repo=${repo_filter}&workflow_name=${workflow_name}&runner=${machine}&status=${status_filter}&job_type=${job_type}&failure_reason=${failure_reason}&search=${search:percentencode}&since=${__from:date:iso}&until=${__to:date:iso}",
        "url_options": { "method": "GET", "data": "" },
        "columns": [
          { "selector": "status", "text": "status", "type": "string" },
          { "selector": "repo", "text": "repo", "type": "string" },
          { "selector": "workflow", "text": "workflow", "type": "string" },
          { "selector": "runner_name", "text": "runner_name", "type": "string" },
          { "selector": "branch", "text": "branch", "type": "string" },
          { "selector": "trigger", "text": "trigger", "type": "string" },
          { "selector": "pr_display", "text": "pr_display", "type": "string" },
          { "selector": "duration", "text": "duration", "type": "string" },
          { "selector": "actor", "text": "actor", "type": "string" },
          { "selector": "failed_step", "text": "failed_step", "type": "string" },
          { "selector": "created_at", "text": "created_at", "type": "timestamp" },
          { "selector": "id", "text": "id", "type": "number" },
          { "selector": "conclusion", "text": "conclusion", "type": "string" },
          { "selector": "event", "text": "event", "type": "string" },
          { "selector": "duration_s", "text": "duration_s", "type": "number" },
          { "selector": "updated_at", "text": "updated_at", "type": "timestamp" },
          { "selector": "run_number", "text": "run_number", "type": "number" },
          { "selector": "run_attempt", "text": "run_attempt", "type": "number" },
          { "selector": "url", "text": "url", "type": "string" },
          { "selector": "pr_url", "text": "pr_url", "type": "string" },
          { "selector": "display_name", "text": "display_name", "type": "string" },
          { "selector": "category", "text": "category", "type": "string" },
          { "selector": "failure_reason", "text": "failure_reason", "type": "string" }
        ]
      }]
    }
  ],
  "schemaVersion": 39,
  "tags": ["osac", "ci", "workflows", "jobs"],
  "templating": {
    "list": [
      {
        "name": "category",
        "label": "Category",
        "type": "custom",
        "query": "e2e,ai,ci,lint,release,automation",
        "current": { "text": "E2E", "value": "e2e", "selected": true },
        "options": [
          { "text": "E2E", "value": "e2e", "selected": true },
          { "text": "AI", "value": "ai", "selected": false },
          { "text": "CI", "value": "ci", "selected": false },
          { "text": "Lint", "value": "lint", "selected": false },
          { "text": "Release", "value": "release", "selected": false },
          { "text": "Automation", "value": "automation", "selected": false }
        ],
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 0
      },
      {
        "name": "repo_filter",
        "label": "Repository",
        "type": "custom",
