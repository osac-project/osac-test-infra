{
  "annotations": {
    "list": []
  },
  "description": "One ci-observe E2E capture at a time: pick it with the Capture variable (Loki label osac_ci_capture_id, newest first). Read the rows top to bottom: Run overview says what ran and whether it passed, Tests drills into the pytest spans, Service requests covers the Beyla service spans, and Logs and Cluster metrics give the environment around the run. Keep the default 7-day time range while picking a capture (captures are imported asynchronously and keep their original timestamps), then narrow the range to the run window for the Cluster panels, which are scoped by time rather than capture id.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Run overview",
      "description": "Read this first: what the run was, whether it passed, and how long it took.",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Tests",
      "description": "Parent pytest test spans (pytest.span_type = test, ::setup/::call/::teardown phase spans excluded) in the selected capture. Tempo caps a spanset at 100 spans, so runs with more than 100 tests are undercounted.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "tempo", "uid": "ci-observe-traces" },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["count"], "fields": "duration", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.\"osac.ci.capture_id\" = \"$capture_id\" && .pytest.span_type = \"test\" && name !~ \".*::(setup|call|teardown)\"}",
          "limit": 100,
          "spss": 100,
          "tableType": "spans"
        }
      ]
    },
    {
      "title": "Failed tests",
      "description": "Test spans with status = error, set by pytest-opentelemetry on failures. Empty when the run passed.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "tempo", "uid": "ci-observe-traces" },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["count"], "fields": "duration", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.\"osac.ci.capture_id\" = \"$capture_id\" && .pytest.span_type = \"test\" && name !~ \".*::(setup|call|teardown)\" && status = error}",
          "limit": 100,
          "spss": 100,
          "tableType": "spans"
        }
      ]
    },
    {
      "title": "Suite",
      "description": "Suite label (osac_ci_suite) carried on the capture's Loki streams; shows 'not labeled' for captures imported before suite labels existed.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "loki", "uid": "ci-observe-logs" },
      "fieldConfig": {
        "defaults": {
          "noValue": "not labeled",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (osac_ci_suite) (count_over_time({osac_ci_capture_id=\"$capture_id\"}[$__range]))",
          "legendFormat": "{{osac_ci_suite}}",
          "queryType": "range"
        }
      ]
    },
    {
      "title": "PR",
      "description": "Pull-request label (osac_ci_pr) carried on the capture's Loki streams; shows 'not labeled' for captures imported before PR labels existed.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "loki", "uid": "ci-observe-logs" },
      "fieldConfig": {
        "defaults": {
          "noValue": "not labeled",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (osac_ci_pr) (count_over_time({osac_ci_capture_id=\"$capture_id\"}[$__range]))",
          "legendFormat": "{{osac_ci_pr}}",
          "queryType": "range"
        }
      ]
    },
    {
      "title": "Run duration",
      "description": "Duration of the longest pytest worker 'test run' span; the workers start together, so this is the wall-clock duration of the run.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "tempo", "uid": "ci-observe-traces" },
      "fieldConfig": {
        "defaults": {
          "noValue": "No run span",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["max"], "fields": "duration", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.\"osac.ci.capture_id\" = \"$capture_id\" && .pytest.span_type = \"run\"}",
          "limit": 100,
          "spss": 100,
          "tableType": "spans"
        }
      ]
    },
    {
      "title": "Tests",
      "description": "The pytest test spans of the capture: every test, the slowest ones, and the failures.",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Test timeline",
      "description": "Test spans ordered by start time. Keep the dashboard time range on the default 7 days (or wider than the run) so the capture's original timestamps are inside the window; narrow it for detail. Tempo returns at most 100 spans per spanset, so runs with more tests are truncated here.",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "tempo", "uid": "ci-observe-traces" },
      "fieldConfig": {
        "defaults": {
          "noValue": "No test spans in this capture"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "name" },
            "properties": [
              { "id": "custom.hideFrom", "value": { "legend": false, "tooltip": false, "viz": false } },
              { "id": "displayName", "value": "Test" },
              { "id": "custom.width", "value": 440 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "traceService" },
            "properties": [{ "id": "displayName", "value": "Service" }]
          },
          {
            "matcher": { "id": "byName", "options": "time" },
            "properties": [{ "id": "displayName", "value": "Start" }]
          },
          {
            "matcher": { "id": "byName", "options": "spanID" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "traceName" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "osac.ci.capture_id" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "pytest.span_type" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Start", "desc": false }],
        "footer": { "show": false }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.\"osac.ci.capture_id\" = \"$capture_id\" && .pytest.span_type = \"test\" && name !~ \".*::(setup|call|teardown)\"}",
          "limit": 100,
          "spss": 100,
          "tableType": "spans"
        }
      ]
    },
