# Podman Quadlet unit file for OSAC Workflow Exporter
# Installed by monitoring-setup.sh to ~/.config/containers/systemd/workflow-exporter.container
#
# Deployed on the CENTRAL machine only.
# Polls the GitHub Actions API for workflow run queue depth and history,
# exposes Prometheus metrics on port 9103.
#
# Quadlet generates a systemd unit (workflow-exporter.service) from this file.
# See: man podman-systemd.unit(5)

[Unit]
Description=Workflow Exporter (OSAC CI Monitoring)



[Container]
Image=localhost/osac-workflow-exporter:latest
ContainerName=workflow-exporter

# Host networking, for two reasons. The ci-observe Tempo 2.10 publishes its
# search API on the host's loopback only (127.0.0.1:3210), so a bridged
# container cannot reach it and /api/ci-observe/runs would answer "unknown"
# forever. And this exporter is itself reached on the host's loopback
# (Grafana's Infinity datasource and Prometheus both use 127.0.0.1:9103).
# With host networking the API would listen on every interface, which is what
# the old PublishPort=127.0.0.1:9103:9103 prevented, so BIND_ADDRESS pins it
# back to loopback. If the exporter ever moves to a bridge network, set
# CI_OBSERVE_TEMPO_URL to an address the container can reach and drop
# Network=host; the code never assumes host networking.
Network=host
Environment=BIND_ADDRESS=127.0.0.1

# Token from shared .env, org name set explicitly
EnvironmentFile=%h/.monitoring-server/.env
Environment=GITHUB_ORG=osac-project
Environment=PORT=9103
Environment=POLL_INTERVAL=90
# The ci-observe Tempo 2.10 search API. Only the parent's capture-view route
# still needs it; capture discovery and /api/ci-observe/runs read the
# registry in workflow-exporter.db and never call Tempo. Override when the
# container does not share the host's loopback. Empty means "use the
# built-in default", which is this same address.
Environment=CI_OBSERVE_TEMPO_URL=http://127.0.0.1:3210
# The capture registry's two label sources: the ci-observe Prometheus and Loki
# both hold osac_ci_capture_id for 30 days. Both are published on the
# host's loopback, reachable because of Network=host.
Environment=CI_OBSERVE_METRICS_URL=http://127.0.0.1:9092
Environment=CI_OBSERVE_LOKI_URL=http://127.0.0.1:3100
Environment=CAPTURE_POLL_INTERVAL=60
# Only the two active repos -- osac-aap, osac-operator, fulfillment-service,
# osac-installer, and bare-metal-fulfillment-operator are archived and no
# longer produce CI activity worth tracking.
Environment=REPOS=osac,osac-test-infra
# Job and pull request history is kept for 30 days. The row-count cap is a
# disk safety net and does not bind at the current event rate.
Environment=JOBS_HISTORY_DAYS=30
Environment=JOBS_HISTORY_MAX_COUNT=400000

# Mount the exporter and its sibling modules into the container
Volume=%h/.monitoring-server/scripts/workflow-exporter.py:/app/workflow-exporter.py:ro,Z
Volume=%h/.monitoring-server/scripts/ci_observe_run_evidence.py:/app/ci_observe_run_evidence.py:ro,Z
Volume=%h/.monitoring-server/scripts/ci_observe_runs.py:/app/ci_observe_runs.py:ro,Z
Volume=%h/.monitoring-server/scripts/ci_observe_capture_view.py:/app/ci_observe_capture_view.py:ro,Z
Volume=%h/.monitoring-server/scripts/ci_observe_trends.py:/app/ci_observe_trends.py:ro,Z
Volume=%h/.monitoring-server/scripts/ci_observe_prs.py:/app/ci_observe_prs.py:ro,Z
# Mount data directory for cache persistence across restarts
Volume=%h/.monitoring-server/data:/data:Z
Environment=CACHE_DIR=/data

[Service]
Restart=always
RestartSec=15
TimeoutStartSec=60

[Install]
WantedBy=default.target
