diff --git a/monitoring/scripts/ci_observe_insights.py b/monitoring/scripts/ci_observe_insights.py
index 389ee3a..fae9214 100644
--- a/monitoring/scripts/ci_observe_insights.py
+++ b/monitoring/scripts/ci_observe_insights.py
@@ -604,9 +604,15 @@ class CIObserveInsights:
 
     @staticmethod
     def _rates(facts):
+        """Pass rate counts each run's last attempt: GitHub keeps one row per
+        run and a re-run replaces its outcome. First-try pass rate counts a
+        run someone re-ran as not passing the first time, so the gap between
+        the two is the failures a re-run hid."""
         passed = sum(1 for fact in facts if fact["result"] == "passed")
         failed = sum(1 for fact in facts if fact["result"] == "failed")
         cancelled = sum(1 for fact in facts if fact["result"] == "cancelled")
+        first_try = sum(1 for fact in facts if fact["result"] == "passed" and (fact["attempt"] or 1) == 1)
+        reruns = sum(1 for fact in facts if (fact["attempt"] or 1) > 1)
         passing_times = [fact["total_s"] for fact in facts if fact["result"] == "passed"]
         return {
             "runs": passed + failed + cancelled,
@@ -614,6 +620,9 @@ class CIObserveInsights:
             "failed": failed,
             "cancelled": cancelled,
             "pass_rate": ratio(passed, passed + failed),
+            "first_try_pass_rate": ratio(first_try, passed + failed),
+            "reruns": reruns,
+            "rerun_share": ratio(reruns, passed + failed + cancelled),
             "median_result_s": percentile(passing_times, 0.5),
             "p90_result_s": percentile(passing_times, 0.9),
             "median_queue_s": percentile([fact["queue_s"] for fact in facts], 0.5),
@@ -702,7 +711,6 @@ class CIObserveInsights:
             "failures_blocked": by_area["Blocked"],
             "infra_share": ratio(by_area["CI infrastructure"], len(failed)),
             "tests_share": ratio(by_area["Tests"], len(failed)),
-            "reruns": sum(1 for fact in finished if fact["attempt"] > 1),
             "runner_hours": round(runner_seconds / 3600, 1),
             "failed_runner_hours": round(failed_seconds / 3600, 1),
             "failed_runner_share": ratio(failed_seconds, runner_seconds),
diff --git a/monitoring/tests/test_ci_observe_insights.py b/monitoring/tests/test_ci_observe_insights.py
index 55db71a..ff5e054 100644
--- a/monitoring/tests/test_ci_observe_insights.py
+++ b/monitoring/tests/test_ci_observe_insights.py
@@ -192,6 +192,23 @@ def test_pass_rate_leaves_cancelled_runs_out(stores):
     assert tile["pass_rate"] == 0.75
 
 
+def test_a_failure_hidden_by_a_re_run_shows_in_the_first_try_pass_rate(stores):
+    """GitHub keeps one row per run and a re-run replaces its outcome: a run
+    that failed and passed on its second attempt reads as passed."""
+    stores.run(NOW - timedelta(hours=3), "success")
+    stores.run(NOW - timedelta(hours=6), "success", attempt=2)
+    stores.run(NOW - timedelta(hours=9), "failure", failed="Run E2E tests")
+    stores.run(NOW - timedelta(hours=12), "cancelled")
+
+    document = get(stores.api(), "health")
+    tile, all_suites = document["tiles"][0], document["suites"][-1]
+
+    assert (tile["pass_rate"], tile["first_try_pass_rate"]) == (round(2 / 3, 4), round(1 / 3, 4))
+    assert (tile["reruns"], tile["rerun_share"]) == (1, 0.25)
+    assert (all_suites["first_try_pass_rate"], all_suites["reruns"]) == (round(1 / 3, 4), 1)
+    assert document["daily"][0]["first_try_pass_rate"] == round(1 / 3, 4)
+
+
 def test_time_to_result_counts_the_wait_for_a_runner(stores):
     """From the first job's creation to the last job's end: the 300 seconds
     in GitHub's queue are part of what the developer waits for."""
